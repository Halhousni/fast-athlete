# Copy this file to .env beside docker-compose.yml.
#
# .env is gitignored, so every deployment keeps its own values and the
# repository stays free of host specific settings.

# Address the app publishes on. The default is loopback: the reverse proxy
# on the same host reaches it there, and nothing else does. Set a specific
# host address only if the proxy runs on another machine.
FAST_BIND_IP=127.0.0.1
